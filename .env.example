PRIVY_APP_ID=
PRIVY_APP_SECRET=
OPENROUTER_API_KEY=
# Local deployment only. The public API does not receive the controller key.
DEV_PRIVATE_KEY=
BNB_RPC=https://bsc-dataseed.bnbchain.org
MURMUR_MODEL=anthropic/claude-haiku-5.5
DAILY_INFERENCE_USD=3
AGENT_DAILY_CALLS=64
# Read-only log history endpoint; confirmed blocks are checked against BNB_RPC.
BNB_HISTORY_RPC=https://rpc-bsc.48.club
BNB_HISTORY_RANGE=5000
# Public payment recipient for user-resident model invoices. Defaults to manifest deployer.
MURMUR_BILLING_RECIPIENT=
# Optional absolute directory for SQLite and mode-0600 resident operator keys.
MURMUR_DATA=

# Optional official profile; omitted from the UI until configured.
MURMUR_X_URL=
